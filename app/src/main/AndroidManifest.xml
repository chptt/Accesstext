<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      This is a consent-based research demonstration.
      It intentionally declares NO networking permission and NO permission that could
      read another app's data. Accessibility inspection is driven entirely by the
      AccessibilityService declared below, which the user must enable by hand.
    -->

    <!--
      Package visibility (API 30+). This does NOT grant access to any other app's data. It only
      lets us answer "is the app you chose actually installed on this device?" so the setup
      screen can tell the researcher before they arm an inspection. The list is deliberately the
      same messaging packages the accessibility config allowlists — nothing broader, and
      QUERY_ALL_PACKAGES is deliberately NOT used.
    -->
    <queries>
        <package android:name="com.google.android.apps.messaging" />
        <package android:name="com.instagram.android" />
        <package android:name="com.instagram.lite" />
        <package android:name="com.whatsapp" />
        <package android:name="org.telegram.messenger" />
        <package android:name="org.thoughtcrime.securesms" />
    </queries>

    <application
        android:name=".GroomingResearchApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.GroomingResearchDemo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GroomingResearchDemo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The accessibility service. It is only ever bound by the Android system after the
          user manually enables it in Settings. android:packageNames in the config XML
          restricts delivered events to a short allowlist of messaging apps, and the service
          narrows that to the single selected compatibility target at connect time, so the app
          never receives events from any other application.
        -->
        <service
            android:name=".service.ChatInspectionService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
